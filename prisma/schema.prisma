// ============================================================
// Portfolio CMS — Prisma Schema (Production)
// Database: Neon PostgreSQL via Vercel
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum Status {
  DRAFT
  PUBLISHED
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

// ============================================================
// USER (Authentication)
// ============================================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   // bcrypt hashed
  role      Role     @default(ADMIN)
  avatar    String?

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?

  // Soft delete
  deletedAt DateTime?

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// ============================================================
// PROFILE (Hero section)
// i18n: roles titles stored as JSON
// ============================================================

model Profile {
  id        String   @id @default(cuid())
  name      String
  firstName String
  lastName  String
  age       Int?
  location  String?
  team      String?

  // Multilingual roles (typing animation)
  // { uz: [...], en: [...], ru: [...] }
  roles     Json     @default("{}")

  // Contact info
  email     String?
  telegram  String?
  telegramUrl String?
  phone     String?
  phoneUrl  String?

  // Media
  avatarUrl String?
  cvUrl     String?

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@map("profiles")
}

// ============================================================
// ABOUT (About section)
// i18n: content per language
// ============================================================

model About {
  id       String  @id @default(cuid())
  slug     String  @unique @default("main")

  // { uz: "...", en: "...", ru: "..." }
  content  Json    @default("{}")

  // Highlights array: [{ icon, en, uz, ru }]
  highlights Json  @default("[]")

  imageUrl  String?
  status    Status  @default(DRAFT)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@map("abouts")
}

// ============================================================
// SKILL
// ============================================================

model Skill {
  id       String  @id @default(cuid())
  name     String
  level    Int     @default(80)
  category String  // "frontend" | "backend" | "database" | "tools" | "ai"
  icon     String?
  order    Int     @default(0)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([category])
  @@index([deletedAt])
  @@map("skills")
}

// ============================================================
// TECH STACK
// ============================================================

model TechStack {
  id       String  @id @default(cuid())
  name     String
  icon     String?
  category String?
  order    Int     @default(0)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("tech_stacks")
}

// ============================================================
// PROJECT
// i18n: tagline, description, features per language
// ============================================================

model Project {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String  // product name (same all langs)
  gradient String? // CSS gradient class

  // { uz: { tagline, description, features[] }, en: {...}, ru: {...} }
  i18n     Json    @default("{}")

  // Legacy / English fallback
  description String? @db.Text
  tags        String[]

  liveUrl    String?
  githubUrl  String?
  imageUrl   String?
  images     String[] // array of image URLs

  status  Status  @default(DRAFT)
  order   Int     @default(0)
  featured Boolean @default(false)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([status])
  @@index([deletedAt])
  @@map("projects")
}

// ============================================================
// SERVICE
// i18n: title, description per language
// ============================================================

model Service {
  id   String  @id @default(cuid())
  slug String  @unique
  icon String?

  // { uz: { title, description }, en: {...}, ru: {...} }
  i18n Json   @default("{}")

  features Json?  // { uz: [...], en: [...], ru: [...] }
  price    String?
  order    Int     @default(0)

  status  Status  @default(DRAFT)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([status])
  @@index([deletedAt])
  @@map("services")
}

// ============================================================
// IN DEVELOPMENT (Coming Soon projects)
// i18n: title, description per language
// ============================================================

model InDevelopment {
  id   String  @id @default(cuid())
  slug String  @unique
  icon String?

  // { uz: { title, description }, en: {...}, ru: {...} }
  i18n     Json    @default("{}")
  tags     String[]
  progress Int     @default(0) // 0-100

  status  Status  @default(DRAFT)
  order   Int     @default(0)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("in_development")
}

// ============================================================
// SOCIAL LINK
// ============================================================

model SocialLink {
  id       String  @id @default(cuid())
  platform String  // "github" | "linkedin" | "telegram" | "email"
  url      String
  icon     String?
  label    String?
  order    Int     @default(0)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("social_links")
}

// ============================================================
// MEDIA (Uploaded files via Vercel Blob)
// ============================================================

model Media {
  id       String  @id @default(cuid())
  filename String
  url      String  // Vercel Blob URL
  alt      String?
  type     String  // "image" | "pdf" | "favicon"
  size     Int?    // bytes
  mimeType String?
  width    Int?
  height   Int?

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([type])
  @@index([deletedAt])
  @@map("media")
}

// ============================================================
// SEO
// ============================================================

model SEO {
  id            String   @id @default(cuid())
  slug          String   @unique @default("main")

  title         String
  description   String   @db.Text
  keywords      String[]
  ogImageUrl    String?
  twitterHandle String?
  canonicalUrl  String?
  robots        String   @default("index, follow")
  faviconUrl    String?

  // i18n SEO: { uz: { title, desc }, en: {...}, ru: {...} }
  i18n          Json     @default("{}")

  status  Status  @default(DRAFT)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@map("seo")
}

// ============================================================
// LANGUAGE (Enabled portfolio languages)
// ============================================================

model Language {
  id      String  @id @default(cuid())
  code    String  @unique // "uz" | "en" | "ru"
  name    String  // "O'zbek" | "English" | "Русский"
  flag    String? // emoji
  enabled Boolean @default(true)
  isDefault Boolean @default(false)
  order   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("languages")
}

// ============================================================
// SETTING (Key-value store for global settings)
// ============================================================

model Setting {
  id    String  @id @default(cuid())
  key   String  @unique
  value String  @db.Text
  label String?
  group String? // "general" | "contact" | "appearance"

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([group])
  @@map("settings")
}
